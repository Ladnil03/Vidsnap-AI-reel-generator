MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/vidsnap
MONGODB_DB=vidsnap
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=vidsnap-reels
JWT_SECRET_KEY=your-very-long-random-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@vidsnap.ai
FREE_TOKENS_ON_SIGNUP=5
ALLOWED_ORIGINS=http://localhost:5173
MAX_IMAGE_SIZE_MB=10
WORKER_POLL_SECONDS=3
