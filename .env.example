# Backend API keys
OPENAI_API_KEY=your_openai_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
FAL_AI_API_KEY=your_fal_ai_api_key_here
RESEND_API_KEY=your_resend_api_key_here
# On Resend free tier without a verified domain, use: EMAIL_FROM=onboarding@resend.dev
# With a verified custom domain, use: EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM=onboarding@resend.dev

# Frontend secrets
SECRET_KEY=your-secret-key-here

# Database
DATABASE_URL=sqlite:///instance/vidsnap.db
