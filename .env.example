# ==============================================================================
# VidSnap.AI — Environment Configuration Template
# 100% Zero-Cost Architecture — ZERO Credit Card Required for Any Free Tier
# ==============================================================================

# Application Environment (development, test, production)
ENVIRONMENT=development
APP_NAME="VidSnap AI"
APP_VERSION="2.0.0"
DEBUG=true

# API Server Configuration
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# Security & Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change_this_to_a_super_secret_random_key_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (comma-separated list)
# Include Flask dev (5000), Next.js dev (3000), Vite dev (5173), and production domains
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:5173,http://127.0.0.1:5000,http://127.0.0.1:3000

# Database — MongoDB Atlas M0 (Free Forever, 512MB — NO Credit Card Required)
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=vidsnap

# Cache & Distributed Queue — Redis 7 (Local or Upstash Serverless — NO Credit Card Required)
REDIS_URL=redis://localhost:6379/0

# Object Storage & Media Delivery — Cloudinary (Primary) or Local Filesystem
# Options: "cloudinary", "local"
# Cloudinary Free Tier gives 25 monthly credits (~25GB storage or 25GB bandwidth) with NO credit card required.
STORAGE_PROVIDER=cloudinary
LOCAL_STORAGE_PATH=./media_storage

# Cloudinary Credentials (Required when STORAGE_PROVIDER=cloudinary or CDN_PROVIDER=cloudinary)
# Sign up free at cloudinary.com (No card needed)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=vidsnap-reels

# Email Delivery — Resend (100/day free) & Brevo (300/day free) — NO Credit Card Required
# Options: "console", "resend", "brevo" (console prints OTP directly to logs for local dev)
EMAIL_PROVIDER=console
EMAIL_FROM=onboarding@resend.dev
RESEND_API_KEY=
BREVO_API_KEY=

# LLM Providers (Free Tier Fallback Chain — NO Credit Card Required)
# 1. Groq Cloud: Free Llama 3.3 70B / 8B (console.groq.com - No card required)
GROQ_API_KEY=
# 2. Google Gemini: Free Gemini 1.5 Flash (aistudio.google.com - No card required)
GEMINI_API_KEY=
# 3. OpenRouter: Free model access (openrouter.ai - No card required)
OPENROUTER_API_KEY=

# Quotas & Limits
FREE_TOKENS_ON_SIGNUP=5
MAX_IMAGE_SIZE_MB=10
MAX_IMAGES_PER_JOB=10
MAX_VOICEOVER_CHARS=900
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10

# Worker Settings
WORKER_CONCURRENCY=2
WORKER_POLL_SECONDS=3
FFMPEG_PRESET=veryfast
FFMPEG_THREADS=2
TARGET_VIDEO_WIDTH=720
TARGET_VIDEO_HEIGHT=1280

# CDN & Edge Caching (Options: "cloudinary", "passthrough")
# Cloudinary provides global multi-CDN (Akamai/Fastly/CloudFront) with automatic f_auto,q_auto optimizations
CDN_PROVIDER=cloudinary
CACHE_MAX_AGE_MEDIA=86400
CACHE_MAX_AGE_API=60

# Discovery APIs (Multi-source Connectors — NO Credit Card Required)
YOUTUBE_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
