# ──────────────────────────────────────────────────────
# Gmail SMTP — Forgot Password OTP delivery
# ──────────────────────────────────────────────────────
# SETUP STEPS:
# 1. Enable 2-Step Verification on your Google Account
# 2. Go to: Google Account → Security → 2-Step Verification → App Passwords
# 3. Create App Password → name it "VidSnap AI"
# 4. Copy the 16-character password Google gives you
# 5. Paste it as GMAIL_APP_PASSWORD below
# 6. Set EMAIL_FROM to that same Gmail address
#
# This delivers OTPs to ANY email address worldwide, completely free.
EMAIL_FROM=yourname@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# Frontend secrets
SECRET_KEY=your-secret-key-here

# Database
DATABASE_URL=sqlite:///instance/vidsnap.db
