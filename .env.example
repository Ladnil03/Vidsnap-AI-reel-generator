# ==============================================================================
# VidSnap.AI — Environment Configuration Template
# All secrets must be provided via environment variables in production.
# ==============================================================================

# Application Environment (development, test, production)
ENVIRONMENT=development
APP_NAME="VidSnap AI"
APP_VERSION="2.0.0"
DEBUG=true

# API Server Configuration
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# Security & Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change_this_to_a_super_secret_random_key_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (comma-separated list)
# Include Flask dev (5000), Next.js dev (3000), Vite dev (5173), and production domains
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:5173,http://127.0.0.1:5000,http://127.0.0.1:3000

# Database — MongoDB Atlas or Local MongoDB
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=vidsnap

# Cache & Distributed Queue — Redis 7
REDIS_URL=redis://localhost:6379/0

# Object Storage — Cloudflare R2 (S3-Compatible) or Local / MinIO
# Options: "r2", "s3", "local"
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./media_storage

# Cloudflare R2 / S3 Settings (Required if STORAGE_PROVIDER=r2 or s3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=vidsnap-media
R2_PUBLIC_URL=https://media.vidsnap.ai


# Legacy Cloudinary (Fallback if needed)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=vidsnap-reels

# Email Delivery — Resend (Primary, 100/day) & Brevo (Fallback, 300/day)
# Options: "resend", "brevo", "console" (console prints OTP to logs for local dev)
EMAIL_PROVIDER=console
EMAIL_FROM=onboarding@resend.dev
RESEND_API_KEY=
BREVO_API_KEY=

# LLM Providers (Free Tier Chain)
GROQ_API_KEY=
GEMINI_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
OPENROUTER_API_KEY=

# Quotas & Limits
FREE_TOKENS_ON_SIGNUP=5
MAX_IMAGE_SIZE_MB=10
MAX_IMAGES_PER_JOB=10
MAX_VOICEOVER_CHARS=900
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10

# Worker Settings
WORKER_CONCURRENCY=2
WORKER_POLL_SECONDS=3
FFMPEG_PRESET=veryfast
FFMPEG_THREADS=2
TARGET_VIDEO_WIDTH=720
TARGET_VIDEO_HEIGHT=1280
