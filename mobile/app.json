{
  "expo": {
    "name": "VidSnap.AI",
    "slug": "vidsnap-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "vidsnap",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#090d16"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vidsnap.ai",
      "infoPlist": {
        "NSCameraUsageDescription": "VidSnap requires camera access to record vertical reels.",
        "NSMicrophoneUsageDescription": "VidSnap requires microphone access for audio voiceovers and watch parties."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#090d16"
      },
      "package": "com.vidsnap.ai",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false
        }
      ]
    ]
  }
}
